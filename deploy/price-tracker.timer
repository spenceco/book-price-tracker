# systemd timer: start price-tracker.service every day at 06:00 UTC.
[Unit]
Description=Run price-tracker daily

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
# Spread load a little; never hit the site at exactly the same second as everyone else
RandomizedDelaySec=10min
# If the server was off at 06:00, run as soon as it boots
Persistent=true

[Install]
WantedBy=timers.target
